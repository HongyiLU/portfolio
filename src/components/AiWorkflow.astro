---
import { withBase } from '../utils/site';

interface Props {
  steps: { label: string; summary: string; image?: string }[];
  note?: string;
  accent?: string;
}

const { steps, note, accent = '#38e0c8' } = Astro.props;
---

<section class="card ai-workflow-panel" style={`--project-accent: ${accent};`}>
  <div class="section-heading">
    <div>
      <p class="eyebrow">AI Dev Workflow</p>
      <h2>AI 开发工作流</h2>
      <p class="content-meta">
        {note ?? '从设计输入到可玩版本的真实制作路径：我负责设计与判断，AI 负责实现，每一轮都在试玩里验证。'}
      </p>
    </div>
  </div>

  {steps.length > 0 ? (
    <ol class="workflow-track" aria-label="AI 开发工作流步骤">
      {steps.map((step, index) => (
        <li class="workflow-step" style={`--step-index: ${index};`}>
          <div class="workflow-rail" aria-hidden="true">
            <span class="workflow-dot"></span>
            {index < steps.length - 1 ? <span class="workflow-line"></span> : null}
          </div>
          <div class="workflow-body">
            <p class="eyebrow">Step {index + 1}</p>
            <strong>{step.label}</strong>
            <p>{step.summary}</p>
            {step.image ? (
              <img src={withBase(step.image)} alt={`${step.label} 示意图`} loading="lazy" decoding="async" />
            ) : null}
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <p>这个项目还没有整理 AI 开发工作流，后续补充。</p>
  )}
</section>

<style>
  .ai-workflow-panel {
    --flow-accent: var(--project-accent, #00a99d);
  }
  .workflow-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .workflow-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }
  .workflow-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.3rem;
  }
  .workflow-dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--flow-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--flow-accent) 18%, transparent);
  }
  .workflow-line {
    flex: 1;
    width: 2px;
    min-height: 2.2rem;
    background: color-mix(in srgb, var(--flow-accent) 30%, transparent);
  }
  .workflow-body {
    padding-bottom: 1.6rem;
  }
  .workflow-body strong {
    display: block;
    margin: 0.15rem 0 0.3rem;
    font-size: 1.02rem;
  }
  .workflow-body p {
    margin: 0;
    color: var(--muted, #4a5568);
    line-height: 1.65;
  }
  .workflow-body img {
    margin-top: 0.8rem;
    width: 100%;
    max-width: 640px;
    border-radius: 6px;
    border: 1px solid var(--border, rgba(0, 0, 0, 0.08));
  }
</style>
