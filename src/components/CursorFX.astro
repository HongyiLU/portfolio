<canvas id="fx-canvas" aria-hidden="true"></canvas>
<div class="fx-cursor-ring" id="fx-ring" aria-hidden="true"></div>
<div class="fx-cursor-dot" id="fx-dot" aria-hidden="true"></div>

<script>
  // 专属鼠标 + 粒子拖尾：仅精确指针设备启用；reduced-motion 整套禁用；
  // View Transitions 换页后 astro:page-load 重新获取画布与光标元素。
  (() => {
    if (!window.matchMedia('(pointer: fine)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;
    let dot: HTMLElement | null = null;
    let ring: HTMLElement | null = null;

    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let rx = mx;
    let ry = my;
    let lastX = mx;
    let lastY = my;
    let particles: { x: number; y: number; vx: number; vy: number; life: number; decay: number; g: string; c: string; s: number }[] = [];
    let bound = false;

    const GLYPHS = ['+', '·', '×'];

    function resize() {
      if (!canvas || !ctx) return;
      canvas.width = window.innerWidth * devicePixelRatio;
      canvas.height = window.innerHeight * devicePixelRatio;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    }

    function spawn(x: number, y: number) {
      if (particles.length > 140) return;
      if (Math.hypot(x - lastX, y - lastY) < 7) return;
      lastX = x;
      lastY = y;
      for (let i = 0; i < 2; i++) {
        const roll = Math.random();
        particles.push({
          x,
          y,
          vx: (Math.random() - 0.5) * 0.9,
          vy: -0.25 - Math.random() * 0.45,
          life: 1,
          decay: 0.016 + Math.random() * 0.014,
          g: roll < 0.55 ? '+' : roll < 0.85 ? '·' : '×',
          c: roll < 0.72 ? '255, 214, 10' : '56, 224, 200',
          s: 0.6 + Math.random() * 0.7
        });
      }
    }

    function frame() {
      requestAnimationFrame(frame);
      if (document.hidden || !ctx) return;
      rx += (mx - rx) * 0.16;
      ry += (my - ry) * 0.16;
      if (dot) dot.style.transform = `translate3d(${mx - 3}px, ${my - 3}px, 0)`;
      if (ring) ring.style.transform = `translate3d(${rx - 15}px, ${ry - 15}px, 0)`;
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      particles = particles.filter((p) => p.life > 0);
      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        p.life -= p.decay;
        ctx.globalAlpha = Math.max(p.life, 0);
        ctx.fillStyle = `rgb(${p.c})`;
        ctx.font = `${Math.round(10 * p.s)}px monospace`;
        ctx.fillText(p.g, p.x, p.y);
      }
      ctx.globalAlpha = 1;
    }

    function onMove(e: MouseEvent) {
      mx = e.clientX;
      my = e.clientY;
      spawn(mx, my);
      const hot = (e.target as Element | null)?.closest?.('a, button, input, select, textarea, [role="button"]');
      ring?.classList.toggle('is-hover', Boolean(hot));
    }

    function init() {
      canvas = document.getElementById('fx-canvas') as HTMLCanvasElement | null;
      dot = document.getElementById('fx-dot');
      ring = document.getElementById('fx-ring');
      if (!canvas) return;
      ctx = canvas.getContext('2d');
      document.documentElement.classList.add('fx-cursor');
      resize();
      if (!bound) {
        bound = true;
        window.addEventListener('mousemove', onMove, { passive: true });
        window.addEventListener('resize', resize);
        frame();
      }
    }

    document.addEventListener('astro:page-load', init);
  })();
</script>

<style>
  /* 自定义光标启用时隐藏原生光标（文本输入保留原生竖线） */
  :global(html.fx-cursor),
  :global(html.fx-cursor *) {
    cursor: none !important;
  }

  :global(html.fx-cursor input),
  :global(html.fx-cursor textarea) {
    cursor: text !important;
  }

  .fx-cursor-dot,
  .fx-cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
    will-change: transform;
  }

  .fx-cursor-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-yellow, #ffd60a);
    box-shadow: 0 0 8px rgba(255, 214, 10, 0.8);
  }

  .fx-cursor-ring {
    width: 30px;
    height: 30px;
    border: 1.5px solid rgba(77, 195, 255, 0.75);
    transition:
      width 0.2s ease,
      height 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .fx-cursor-ring.is-hover {
    width: 40px;
    height: 40px;
    border-color: var(--accent-yellow, #ffd60a);
    background: rgba(255, 214, 10, 0.06);
  }

  #fx-canvas {
    position: fixed;
    inset: 0;
    z-index: 9998;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* 触屏与减少动态偏好：整套禁用 */
  @media (pointer: coarse) {
    .fx-cursor-dot,
    .fx-cursor-ring,
    #fx-canvas {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx-cursor-dot,
    .fx-cursor-ring,
    #fx-canvas {
      display: none !important;
    }

    :global(html.fx-cursor),
    :global(html.fx-cursor *) {
      cursor: auto !important;
    }
  }
</style>
