---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/editorial.css';
import { siteMeta } from '../utils/site-meta';
import { toSiteUrl, withBase, withoutBase } from '../utils/site';
import type { JsonLdInput } from '../utils/schema';
import { serializeJsonLd } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonicalPath?: string;
  robots?: string;
  structuredData?: JsonLdInput;
}

const {
  title = `${siteMeta.name} | ${siteMeta.title}`,
  description = siteMeta.description,
  image,
  type = 'website',
  canonicalPath,
  robots,
  structuredData
} = Astro.props;

const canonical = Astro.site ? toSiteUrl(canonicalPath ?? withoutBase(Astro.url.pathname), Astro.site) : Astro.url.toString();
const imageUrl = image
  ? Astro.site
    ? toSiteUrl(image, Astro.site)
    : withBase(image)
  : Astro.site
    ? toSiteUrl(siteMeta.shareImage, Astro.site)
    : withBase(siteMeta.shareImage);
const structuredDataItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="theme-color" content="#05080f" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteMeta.name} RSS`} href={withBase('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={withBase(siteMeta.favicon)} />
    <link rel="apple-touch-icon" href={withBase(siteMeta.favicon)} />
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={serializeJsonLd(item)} />
    ))}
    <title>{title}</title>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div id="boot-overlay" class="boot-overlay" hidden aria-hidden="true">
      <div class="boot-term" id="boot-term"></div>
    </div>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class="page-shell">
      <Nav />
      <main class="page-main" id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // 开机序列：每次刷新播放（站内 View Transitions 切换不重播）；reduced-motion 跳过
      function initPageFeatures() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const boot = document.getElementById('boot-overlay');
      let bootPlayed = false;
      const typeBootLine = (line, el) => new Promise((done) => {
        let i = 0;
        const timer = setInterval(() => {
          el.textContent = line.slice(0, ++i);
          if (i >= line.length) { clearInterval(timer); done(); }
        }, 20);
      });
      if (boot && !prefersReducedMotion && !window.__booted) {
        boot.hidden = false;
        document.documentElement.classList.add('booting');
        bootPlayed = true;
        const term = boot.querySelector('#boot-term');
        const lines = [
          'ESTABLISHING LINK ...... OK',
          'LOADING GAME ARCHIVE ... OK',
          'CORE LOOP MODULE ....... READY',
          'WELCOME, VISITOR_'
        ];
        (async () => {
          for (const line of lines) {
            const p = document.createElement('p');
            p.innerHTML = '<b>&gt;</b> ';
            const span = document.createElement('span');
            p.append(span);
            term.append(p);
            await typeBootLine(line, span);
            await new Promise((r) => setTimeout(r, 200));
          }
          await new Promise((r) => setTimeout(r, 450));
          boot.classList.add('boot-fade');
          await new Promise((r) => setTimeout(r, 380));
          boot.remove();
          document.documentElement.classList.remove('booting');
        })();
        window.__booted = true;
      } else {
        boot?.remove();
      }

      // 打字机 Hero 标题（仅首页；每次刷新随开机序列重播）
      const heroTitle = document.querySelector('.home-banner h1');
      if (heroTitle && !prefersReducedMotion && !window.__typed) {
        const text = heroTitle.textContent;
        heroTitle.setAttribute('aria-label', text);
        heroTitle.textContent = '';
        const typingDelay = bootPlayed ? 3.0 : 0.15;
        [...text].forEach((char, index) => {
          const span = document.createElement('span');
          span.className = 'type-ch';
          span.textContent = char;
          span.style.setProperty('--type-at', `${typingDelay + index * 0.055}s`);
          heroTitle.append(span);
        });
        const cursor = document.createElement('span');
        cursor.className = 'type-cursor';
        cursor.style.setProperty('--type-at', `${typingDelay + text.length * 0.055}s`);
        heroTitle.append(cursor);
        window.__typed = true;
      }

      // 顶部滚动进度线
      const progress = document.querySelector('.scroll-progress');
      if (progress) {
        const setProgress = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
        };
        if (!window.__progressBound) {
          window.__progressBound = true;
          window.addEventListener('scroll', setProgress, { passive: true });
        }
        setProgress();
      }

      // CYCLE 计数器（站点上线天数）
      const cycleDay = document.getElementById('cycle-day');
      if (cycleDay) {
        const days = Math.max(1, Math.floor((Date.now() - new Date('2026-09-12T00:00:00+08:00').getTime()) / 86400000) + 1);
        cycleDay.textContent = String(days).padStart(3, '0');
      }

      // 标语故障相位错开：每条标语错开 1.9 秒，避免同时闪烁
      document.querySelectorAll('.section-statement').forEach((el, index) => {
        el.style.setProperty('--glitch-delay', `${(index * 1.9).toFixed(1)}s`);
      });

      // 滚动入场：模块进入视口时"上浮 + 描边辉光"上线，网格子项错峰
      const gridSelectors = [
        '.grid--cards-lg',
        '.play-lane',
        '.positioning-grid',
        '.core-loop-track',
        '.workflow-track',
        '.milestone-list',
        '.screenshot-grid',
        '.project-switcher-grid',
        '.about-method-grid',
        '.about-now-list',
        '.project-evidence-grid',
        '.archive-metrics',
        '.meta-grid'
      ];
      const targets = [
        ...document.querySelectorAll('.page-main > *, .content-main > *, .side-stack > *'),
        ...[...document.querySelectorAll(gridSelectors.join(','))].flatMap((group) => [...group.children])
      ];
      const unique = [...new Set(targets)];

      if (prefersReducedMotion) {
        // 减少动态偏好：直接全部可见，不做入场
      } else {
        for (const el of unique) {
          el.classList.add('js-reveal');
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target;
              const index = Number(el.dataset.revealIndex ?? 0);
              el.style.transitionDelay = `${Math.min(index * 70, 420)}ms`;
              el.classList.add('is-revealed');
              observer.unobserve(el);
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );
        for (const el of unique) {
          const parent = el.parentElement;
          const siblings = parent ? [...parent.children].filter((c) => c.classList.contains('js-reveal')) : [];
          el.dataset.revealIndex = String(siblings.indexOf(el));
          observer.observe(el);
        }
      }
      }
      document.addEventListener('astro:page-load', initPageFeatures);
    </script>
  </body>
</html>
